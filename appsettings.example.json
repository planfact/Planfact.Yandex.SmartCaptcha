{
    "SmartCaptcha": {
        "IsEnabled": true,
        "AuthType": "SecretKey",
        "SecretKey": "YOUR_YANDEX_SMARTCAPTCHA_SECRET_KEY",
        "IamToken": null,
        "ApiKey": null,
        "SkipIpAddresses": [
            "127.0.0.1",
            "::1"
        ],
        "TimeoutSeconds": 30
    },
    "// Альтернативные варианты аутентификации": {
        "// IAM Token (для продвинутых сценариев)": {
            "AuthType": "IamToken",
            "IamToken": "YOUR_IAM_TOKEN_HERE",
            "SecretKey": null
        },
        "// API Key (упрощенный метод)": {
            "AuthType": "ApiKey",
            "ApiKey": "YOUR_API_KEY_HERE",
            "SecretKey": null
        }
    }
}
